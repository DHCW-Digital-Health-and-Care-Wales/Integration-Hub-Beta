<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="urn:hl7-org:v2xml" targetNamespace="urn:hl7-org:v2xml" elementFormDefault="qualified" version="2.0.1">
    <xsd:element name="ORU_R01">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="MSH" type="MSH">
                </xsd:element>
                <xsd:element name="ORU_R01.PATIENT_RESULT" maxOccurs="unbounded">
                    <xsd:complexType>
						<xsd:sequence>
                            <xsd:element name="ORU_R01.PATIENT">
                                <xsd:complexType>
						            <xsd:sequence>
                                        <xsd:element name="PID" type="PID"/>
                                        <xsd:element name="PD1" type="PD1" minOccurs="0"/>
                                        <xsd:element name="NTE" type="NTE" minOccurs="0" maxOccurs="unbounded"/>
                                        <xsd:element name="ORU_R01.VISIT">
                                            <xsd:complexType>
						                        <xsd:sequence>
                                                    <xsd:element name="PV1" type="PV1"/>
                                                    <xsd:element name="PV2" type="PV2" minOccurs="0"/>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element name="ORU_R01.ORDER_OBSERVATION" maxOccurs="unbounded">
                                <xsd:complexType>
						            <xsd:sequence>
                                        <xsd:element name="ORC" type="ORC" minOccurs="0"/>
                                        <xsd:element name="OBR" type="OBR" />
                                        <xsd:element name="NTE" type="NTE" minOccurs="0" maxOccurs="unbounded"/>
                                        <xsd:element name="ORU_R01.TIMING_QTY" minOccurs="0" maxOccurs="unbounded">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="TQ1" type="TQ1"/>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
                                        <xsd:element name="ORU_R01.OBSERVATION" minOccurs="0" maxOccurs="unbounded">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="OBX" type="OBX"/>
													<xsd:element name="NTE" type="NTE" minOccurs="0" maxOccurs="unbounded"/>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
                                        <xsd:element name="ORU_R01.SPECIMEN" minOccurs="0" maxOccurs="unbounded">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="SPM" type="SPM"/>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
                                    </xsd:sequence>
                                </xsd:complexType>
                            </xsd:element>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
    <xsd:complexType name="MSH">
        <xsd:annotation>
			<xsd:documentation>MSH shall not contain data pertaining to a patient or the contained result. For example, facility code will not be used to derive Assigning Authority for a patient's identifier.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="MSH.1" type="ST">
				<xsd:annotation>
					<xsd:documentation>Field seperator</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MSH.2" type="ST">
				<xsd:annotation>
					<xsd:documentation>Encoding Characters</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MSH.3" type="MSH3.HD">
				<xsd:annotation>
					<xsd:documentation>Sending Application: |NHSWales^2.16.840.1.113883.2.1.8.1.5.249^ISO| If ^ exists then treated as HD type else ST </xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MSH.4" type="MSH4.HD">
				<xsd:annotation>
					<xsd:documentation>Sending Facility: CTM^7A5B1 = Royal Glamorgan Hospital, Cwm Taf HB. if ^ exists then treat as type HD, otherwise treat as ST for backwards compatibility</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MSH.5" type="MSH5.HD">
				<xsd:annotation>
					<xsd:documentation>Receiving Application - |INSE^2.16.840.1.113883.2.1.8.1.5.200^ISO|</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MSH.6" type="MSH6.HD">
				<xsd:annotation>
					<xsd:documentation>Receiving Facility - |cymru.nhs.uk^RQFW3^L|</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MSH.7" type="MSH7.TS">
				<xsd:annotation>
					<xsd:documentation>DateTime of Message</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MSH.8" type="ST" minOccurs="0"/>
			<xsd:element name="MSH.9" type="MSH.9.MSG">
				<xsd:annotation>
					<xsd:documentation>Message Type |ORU^R01^ORU_R01|</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MSH.10">
				<xsd:annotation>
					<xsd:documentation>Unique value per message, up to 20 character alpha numeric string </xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="MSH.10.ST">
						<xsd:maxLength value="20"/>
						<xsd:minLength value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="MSH.11" type="PT"/>
			<xsd:element name="MSH.12" type="VID"/>
			<xsd:element name="MSH.13" type="NM" minOccurs="0"/>
			<xsd:element name="MSH.14" type="ST" minOccurs="0"/>
			<xsd:element name="MSH.15" type="ID" minOccurs="0"/>
			<xsd:element name="MSH.16" type="ID" minOccurs="0"/>
			<xsd:element name="MSH.17" type="ID" minOccurs="0"/>
			<xsd:element name="MSH.18" type="ID" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="MSH.19" type="CE" minOccurs="0"/>
			<xsd:element name="MSH.20" type="ID" minOccurs="0"/>
			<xsd:element name="MSH.21" type="EI" minOccurs="0" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="MSH3.HD">
		<xsd:sequence>
			<xsd:element name="HD.1" >
				<xsd:simpleType>
					<xsd:restriction base="MSH3.HD1.IS"/>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="HD.2">
				<xsd:annotation>
					<xsd:documentation>Application Instance OID </xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="MSH3.HD2.ST">
						<xsd:pattern value="([0-2])((\.)|(\.[1-9][0-9]*))*"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="HD.3" type="ID" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="MSH4.HD">
		<xsd:sequence>
			<xsd:element name="HD.1" >
				<xsd:simpleType>
					<xsd:restriction base="MSH4.HD1.IS"/>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="HD.2" type="ST" minOccurs="0"/>
			<xsd:element name="HD.3" type="ID" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="MSH5.HD">
		<xsd:sequence>
			<xsd:element name="HD.1" >
				<xsd:simpleType>
					<xsd:restriction base="MSH5.HD1.IS"/>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="HD.2" >
				<xsd:annotation>
					<xsd:documentation>OID</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="MSH5.HD2.ST">
						<xsd:pattern value="([0-2])((\.)|(\.[1-9][0-9]*))*"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="HD.3" type="ID" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="MSH6.HD">
		<xsd:sequence>
			<xsd:element name="HD.1">
				<xsd:simpleType>
					<xsd:restriction base="MSH6.HD1.IS"/>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="HD.2" type="ST" minOccurs="0"/>
			<xsd:element name="HD.3" type="ID" minOccurs="0"/>	
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="MSH7.TS">
		<xsd:sequence>
			<xsd:element name="TS.1">
				<xsd:annotation>
					<xsd:documentation>|20170126143602| or |20170126143602+0000| where any value up to + is date. Anything after + will be treated as time zone</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="MSH7.TS1.DTM">
						<xsd:pattern value="[0-9]{1,8}|([0-9]{9,14}|[0-9]{14,14}.[0-9]+)([+-][0-9]{1,4})?"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="TS.2" type="ID" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="MSH7.TS1.DTM">
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	<xsd:simpleType name="MSH3.HD2.ST">
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	<xsd:simpleType name="MSH5.HD2.ST">
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	<xsd:simpleType name="MSH.10.ST">
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	<xsd:simpleType name="MSH6.HD1.IS">
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	<xsd:simpleType name="MSH5.HD1.IS">
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	<xsd:simpleType name="MSH4.HD1.IS">
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	<xsd:simpleType name="MSH3.HD1.IS">
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	<xsd:complexType name="PID">
		<xsd:sequence>
			<xsd:element name="PID.1" type="SI" minOccurs="0"/>
			<xsd:element name="PID.2" type="CX" minOccurs="0"/>
			<xsd:element name="PID.3" type="PID3.CX" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>Patient Identifier List</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PID.4" type="CX" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="PID.5" type="PID5.XPN" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>Patient Name. Surname, forename component - Mandatory</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PID.6" type="XPN" minOccurs="0" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>Mother's Maiden Name not required</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PID.7" type="PID7.TS"/>
			<xsd:element name="PID.8" type="IS" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>optional but, if supplied please refer to the language codes described in Core Reference Data Standards.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PID.9" type="XPN" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="PID.10" type="CE" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="PID.11" type="XAD.Address" minOccurs="0" maxOccurs="unbounded">
			<xsd:annotation>
					<xsd:documentation>Patient Address Example
						|1 High Street^Cathays^Cardiff^Mid Glamorgan^CF11 8UL^^H|
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PID.12" type="IS" minOccurs="0"/>
			<xsd:element name="PID.13" type="XTN.PHONE" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="PID.14" type="XTN.PHONE" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="PID.15" type="CE" minOccurs="0"/>
			<xsd:element name="PID.16" type="CE" minOccurs="0"/>
			<xsd:element name="PID.17" type="CE" minOccurs="0"/>
			<xsd:element name="PID.18" type="CX" minOccurs="0"/>
			<xsd:element name="PID.19" type="ST" minOccurs="0"/>
			<xsd:element name="PID.20" type="DLN" minOccurs="0"/>
			<xsd:element name="PID.21" type="CX" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="PID.22" type="CE" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="PID.23" type="ST" minOccurs="0"/>
			<xsd:element name="PID.24" type="ID" minOccurs="0"/>
			<xsd:element name="PID.25" type="NM" minOccurs="0"/>
			<xsd:element name="PID.26" type="CE" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="PID.27" type="CE" minOccurs="0"/>
			<xsd:element name="PID.28" type="CE" minOccurs="0"/>
			<xsd:element name="PID.29" type="TS" minOccurs="0"/>
			<xsd:element name="PID.30" type="ID" minOccurs="0"/>
			<xsd:element name="PID.31" type="ID" minOccurs="0"/>
			<xsd:element name="PID.32" type="IS" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="PID.33" type="TS" minOccurs="0"/>
			<xsd:element name="PID.34" type="HD" minOccurs="0"/>
			<xsd:element name="PID.35" type="CE" minOccurs="0"/>
			<xsd:element name="PID.36" type="CE" minOccurs="0"/>
			<xsd:element name="PID.37" type="ST" minOccurs="0"/>
			<xsd:element name="PID.38" type="CE" minOccurs="0"/>
			<xsd:element name="PID.39" type="CWE" minOccurs="0" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="PID3.CX">
		<xsd:sequence>
			<xsd:element name="CX.1" type="ST">
				<xsd:annotation>
					<xsd:documentation>Identifier: A999999, 0123456789, ABC123</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="CX.2" type="ST" minOccurs="0"/>
			<xsd:element name="CX.3" type="ID" minOccurs="0"/>
			<xsd:element name="CX.4" type="PID3.CX4.HD">
				<xsd:annotation>
					<xsd:documentation>Assgning Authority</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="CX.5" type="ID"/>
			<xsd:element name="CX.6" type="HD" minOccurs="0"/>
			<xsd:element name="CX.7" type="DT" minOccurs="0"/>
			<xsd:element name="CX.8" type="DT" minOccurs="0"/>
			<xsd:element name="CX.9" type="CWE" minOccurs="0"/>
			<xsd:element name="CX.10" type="CWE" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="PID3.CX4.HD">
		<xsd:sequence>
			<xsd:element name="HD.1" type="IS" >
				<xsd:annotation>
					<xsd:documentation>Namespace Id </xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="HD.2" type="ST" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Universal Id</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="HD.3" type="ID" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Univseral Id Type</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="PID7.TS">
		<xsd:sequence>
			<xsd:element name="TS.1">
				<xsd:annotation>
					<xsd:documentation>Date/Time of Birth |20010328| or |200103281054|</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="DTM">
						<xsd:pattern value="[0-9]{0,12}"/> 
						<xsd:maxLength value="12"/> 
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="TS.2" type="ID" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="XAD.Address">
		<xsd:sequence>
			<xsd:element name="XAD.1" type="SAD" minOccurs="0"/>
			<xsd:element name="XAD.2" type="ST" minOccurs="0"/>
			<xsd:element name="XAD.3" type="ST" minOccurs="0"/>
			<xsd:element name="XAD.4" type="ST" minOccurs="0"/>
			<xsd:element name="XAD.5" minOccurs="0">
				<xsd:simpleType>
					<xsd:restriction base="ST">
						<xsd:maxLength value="8"/>
						<xsd:pattern value="([Gg][Ii][Rr] 0[Aa]{2})|((([A-Za-z][0-9]{1,2})|(([A-Za-z][A-Ha-hJ-Zj-z][0-9]{1,2})|(([A-Za-z][0-9][A-Za-z])|([A-Za-z][A-Ha-hJ-Zj-z][0-9][A-Za-z]?))))\s?[0-9][A-Za-z]{2})"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="XAD.6" type="ID" minOccurs="0"/>
			<xsd:element name="XAD.7" type="ID" minOccurs="0"/>
			<xsd:element name="XAD.8" type="ST" minOccurs="0"/>
			<xsd:element name="XAD.9" type="IS" minOccurs="0"/>
			<xsd:element name="XAD.10" type="IS" minOccurs="0"/>
			<xsd:element name="XAD.11" type="ID" minOccurs="0"/>
			<xsd:element name="XAD.12" type="DR" minOccurs="0"/>
			<xsd:element name="XAD.13" type="TS" minOccurs="0"/>
			<xsd:element name="XAD.14" type="TS" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="PID5.XPN">
		<xsd:sequence>
			<xsd:element name="XPN.1" type="FN" />
			<xsd:element name="XPN.2" type="ST" />
			<xsd:element name="XPN.3" type="ST" minOccurs="0"/>
			<xsd:element name="XPN.4" type="ST" minOccurs="0"/>
			<xsd:element name="XPN.5" type="ST" minOccurs="0"/>
			<xsd:element name="XPN.6" type="IS" minOccurs="0"/>
			<xsd:element name="XPN.7" type="ID" default="L" minOccurs="0"/>
			<xsd:element name="XPN.8" type="ID" minOccurs="0"/>
			<xsd:element name="XPN.9" type="CE" minOccurs="0"/>
			<xsd:element name="XPN.10" type="DR" minOccurs="0"/>
			<xsd:element name="XPN.11" type="ID" minOccurs="0"/>
			<xsd:element name="XPN.12" type="TS" minOccurs="0"/>
			<xsd:element name="XPN.13" type="TS" minOccurs="0"/>
			<xsd:element name="XPN.14" type="ST" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="XTN.PHONE">
		<xsd:sequence>
			<xsd:element name="XTN.1" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Telephone numbers should not include any text data in them. E.g. MUM: 07123 456789. Comments like that should appear in PID.13.9. </xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="ST">
						<xsd:pattern value="([0-9 ]+){0,25}"/> 
						<xsd:maxLength value="25"/> 
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="XTN.2" type="ID" minOccurs="0"/>
			<xsd:element name="XTN.3" type="ID" minOccurs="0"/>
			<xsd:element name="XTN.4" type="ST" minOccurs="0"/>
			<xsd:element name="XTN.5" type="NM" minOccurs="0"/>
			<xsd:element name="XTN.6" type="NM" minOccurs="0"/>
			<xsd:element name="XTN.7" type="NM" minOccurs="0"/>
			<xsd:element name="XTN.8" type="NM" minOccurs="0"/>
			<xsd:element name="XTN.9" type="ST" minOccurs="0"/>
			<xsd:element name="XTN.10" type="ST" minOccurs="0"/>
			<xsd:element name="XTN.11" type="ST" minOccurs="0"/>
			<xsd:element name="XTN.12" type="ST" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="PD1">
		<xsd:sequence>
			<xsd:element name="PD1.1" type="IS" minOccurs="0"/>
			<xsd:element name="PD1.2" type="IS" minOccurs="0"/>
			<xsd:element name="PD1.3" type="XON" minOccurs="0"/>
			<xsd:element name="PD1.4" type="XCN" minOccurs="0"/>
			<xsd:element name="PD1.5" type="IS" minOccurs="0"/>
			<xsd:element name="PD1.6" type="IS" minOccurs="0"/>
			<xsd:element name="PD1.7" type="IS" minOccurs="0"/>
			<xsd:element name="PD1.8" type="IS" minOccurs="0"/>
			<xsd:element name="PD1.9" type="ID" minOccurs="0"/>
			<xsd:element name="PD1.10" type="CX" minOccurs="0"/>
			<xsd:element name="PD1.11" type="CE" minOccurs="0"/>
			<xsd:element name="PD1.12" type="ID" minOccurs="0"/>
			<xsd:element name="PD1.13" type="DT" minOccurs="0"/>
			<xsd:element name="PD1.14" type="XON" minOccurs="0"/>
			<xsd:element name="PD1.15" type="CE" minOccurs="0"/>
			<xsd:element name="PD1.16" type="IS" minOccurs="0"/>
			<xsd:element name="PD1.17" type="DT" minOccurs="0"/>
			<xsd:element name="PD1.18" type="DT" minOccurs="0"/>
			<xsd:element name="PD1.19" type="IS" minOccurs="0"/>
			<xsd:element name="PD1.20" type="IS" minOccurs="0"/>
			<xsd:element name="PD1.21" type="IS" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="NTE">
		<xsd:sequence>
			<xsd:element name="NTE.1" type="SI" minOccurs="0"/>
			<xsd:element name="NTE.2" type="ID" minOccurs="0"/>
			<xsd:element name="NTE.3" type="FT" minOccurs="0"/>
			<xsd:element name="NTE.4" type="CE" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="PV1">
		<xsd:sequence>
			<xsd:element name="PV1.1" type="SI" minOccurs="0"/>
			<xsd:element name="PV1.2">
				<xsd:simpleType>
					<xsd:restriction base="PV1.2.IS">
						<xsd:enumeration value="B"/>
						<xsd:enumeration value="C"/>
						<xsd:enumeration value="E"/>
						<xsd:enumeration value="I"/>
