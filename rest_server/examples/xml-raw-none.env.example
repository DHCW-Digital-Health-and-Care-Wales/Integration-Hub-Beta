# Plain XML, no schema validation. Only use this with an explicit, documented justification -
# VALIDATOR_TYPE=none removes the schema trust boundary (see README.md "Security").
# Copy to rest_server/.env for local testing (uv run python -m rest_server).
# .env is gitignored - real values never get committed.

# --- Service Bus / message store / audit ---
SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
EGRESS_QUEUE_NAME="local-inthub-rest-server-ingress"
EGRESS_SESSION_ID="rest-server"
MESSAGE_STORE_QUEUE_NAME="local-inthub-messagestore"
WORKFLOW_ID="rest-server"
MICROSERVICE_ID="rest_server"
HEALTH_BOARD="TEST"
PEER_SERVICE="MPI"

# --- HTTP transport ---
HOST="0.0.0.0"
PORT="8080"
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
HEALTH_CHECK_HOST="0.0.0.0"
HEALTH_CHECK_PORT="9000"

# --- generic pipeline: xml-raw + none ---
PIPELINE="generic"
ENDPOINT_PATH="/ingest"
CONTENT_ADAPTER="xml-raw"
VALIDATOR_TYPE="none"
OUTPUT_FORMAT="raw"
