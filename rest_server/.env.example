# Copy this file to .env for local testing (uv run python -m rest_server).
# .env is gitignored - real values never get committed.
# Values already present in the real environment always take precedence over this file.

# --- Service Bus / message store / audit (shared with hl7_server, hl7_soap_server) ---
SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
EGRESS_QUEUE_NAME="local-inthub-rest-server-ingress"
EGRESS_SESSION_ID="rest-server"
MESSAGE_STORE_QUEUE_NAME="local-inthub-messagestore"
WORKFLOW_ID="rest-server"
MICROSERVICE_ID="rest_server"
HEALTH_BOARD="TEST"
PEER_SERVICE="MPI"

# --- HTTP transport ---
HOST="0.0.0.0"
PORT="8080"
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
HEALTH_CHECK_HOST="0.0.0.0"
HEALTH_CHECK_PORT="9000"
ENDPOINT_PATH="/ingest"

# --- Content adapter / validator / output profile - pick one combination ---
# Only valid when PIPELINE=generic (default). See the "hl7 pipeline" block below for PIPELINE=hl7.
CONTENT_ADAPTER="xml-raw"
VALIDATOR_TYPE="none"
OUTPUT_FORMAT="raw"
# VALIDATION_SCHEMA=""
# ALLOWED_HL7_STRUCTURES="ADT_A05,ADT_A39"
# ALLOWED_SOURCE_IDENTIFIERS=""
# SOURCE_IDENTIFIER_LOCATOR=""
# MESSAGE_CONTROL_ID_LOCATOR=""

# --- hl7 pipeline (uncomment PIPELINE and remove CONTENT_ADAPTER/VALIDATOR_TYPE/OUTPUT_FORMAT above) ---
# PIPELINE="hl7"
# ENVIRONMENT="DEV"
# HL7_VERSION=""
# SENDING_APP=""
# HL7_VALIDATION_FLOW=""
# HL7_VALIDATION_STANDARD=""
# WRRS_QUEUE_NAME=""
# WRRS_EGRESS_SESSION_ID=""
# WRRS_WORKFLOW_ID=""

# --- Optional in-process TLS ---
# TLS_CERT_FILE="/run/certs/tls.crt"
# TLS_KEY_FILE="/run/certs/tls.key"
