# SOAP + HL7 v2.xml, HL7-XSD validation - same rules as hl7_soap_server (e.g. LIMS -> MPI).
# Copy to rest_server/.env for local testing (uv run python -m rest_server).
# .env is gitignored - real values never get committed.

# --- Service Bus / message store / audit ---
SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
EGRESS_QUEUE_NAME="local-inthub-lims-transform"
EGRESS_SESSION_ID="lims-to-mpi"
MESSAGE_STORE_QUEUE_NAME="local-inthub-messagestore"
WORKFLOW_ID="lims-to-mpi"
MICROSERVICE_ID="rest_server"
HEALTH_BOARD="TEST"
PEER_SERVICE="MPI"

# --- HTTP transport ---
HOST="0.0.0.0"
PORT="8080"
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
HEALTH_CHECK_HOST="0.0.0.0"
HEALTH_CHECK_PORT="9000"

# --- generic pipeline: soap + hl7-xsd ---
PIPELINE="generic"
ENDPOINT_PATH="/soap"
CONTENT_ADAPTER="soap"
VALIDATOR_TYPE="hl7-xsd"
VALIDATION_SCHEMA="phw"
ALLOWED_HL7_STRUCTURES="ADT_A05,ADT_A39"
ALLOWED_SOURCE_IDENTIFIERS="328"
OUTPUT_FORMAT="er7"
