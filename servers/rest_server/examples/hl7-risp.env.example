# hl7 pipeline, RISP flow (multi-destination fan-out - see README.md "What the hl7 pipeline does").
# Copy to rest_server/.env for local testing (uv run python -m rest_server).
# .env is gitignored - real values never get committed.

# --- Service Bus / message store / audit ---
SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
EGRESS_QUEUE_NAME="pre-risp-transform"
EGRESS_SESSION_ID="risp-to-mpi"
MESSAGE_STORE_QUEUE_NAME="local-inthub-messagestore"
WORKFLOW_ID="risp-to-mpi"
MICROSERVICE_ID="rest_server"
HEALTH_BOARD="TEST"
PEER_SERVICE="MPI"

# --- HTTP transport ---
HOST="0.0.0.0"
PORT="8080"
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
HEALTH_CHECK_HOST="0.0.0.0"
HEALTH_CHECK_PORT="9000"

# --- hl7 pipeline: risp flow (fans out to a second, WRRS destination) ---
PIPELINE="hl7"
ENVIRONMENT="DEV"
HL7_VALIDATION_FLOW="risp"
WRRS_QUEUE_NAME="risp-to-wrrs"
WRRS_EGRESS_SESSION_ID="risp-to-wrrs"
WRRS_WORKFLOW_ID="risp-to-wrrs"
