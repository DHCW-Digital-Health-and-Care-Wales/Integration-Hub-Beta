# Local development env for soap_subscription_sender
# Mirrors soap-sender.env with topic/subscription fields instead of queue fields

SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_NAMESPACE=

INGRESS_TOPIC_NAME=post-phw-transform
INGRESS_SUBSCRIPTION_NAME=soap-subscription-sender
INGRESS_SESSION_ID=

SOAP_ENDPOINT_URL=http://localhost:8080/soap
SOAP_TIMEOUT_SECONDS=30
SOAP_API_KEY=
SOAP_CLIENT_CERT_PATH=
WS_SECURITY_ENABLED=false

WORKFLOW_ID=local-workflow
MICROSERVICE_ID=soap-subscription-sender
HEALTH_BOARD=LOCAL
PEER_SERVICE=http-mock-receiver

MAX_MESSAGES_PER_MINUTE=

LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
