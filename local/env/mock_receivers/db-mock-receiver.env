# DB Mock Receiver - local testing only. MSSQL_SA_PASSWORD comes from local/.secrets.
# Mock WRRS DRS database + dbo.prQueueMessage on a real SQL Server (see mock_receivers/db_mock_receiver/README.md).
ACCEPT_EULA=Y
# Caps SQL Server's memory use; the container still needs a Docker VM with >= 2 GB RAM to start.
MSSQL_MEMORY_LIMIT_MB=1024
