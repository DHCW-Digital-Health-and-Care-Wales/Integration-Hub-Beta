# HTTP Mock Receiver — local development environment
# Service Bus forwarding is disabled (no EGRESS_QUEUE_NAME set) — log-only mode.
# Uncomment and populate the Service Bus variables to enable forwarding.

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN

# Optional — enable Service Bus forwarding to the local emulator
# SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
# EGRESS_QUEUE_NAME=
# EGRESS_SESSION_ID=
