# SOAP Sender (WIS) — local development environment
# Points at the http_mock_receiver running on localhost:8080

SOAP_ENDPOINT_URL=http://localhost:8080/soap
SOAP_TIMEOUT_SECONDS=30
SOAP_ENVELOPE_FORMAT=wis

# Auth stubs — leave empty for local testing against the mock receiver
SOAP_API_KEY=
SOAP_CLIENT_CERT_PATH=
WS_SECURITY_ENABLED=false

# Service Bus — local emulator
SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
INGRESS_QUEUE_NAME=local-inthub-wis-soap-sender-ingress
INGRESS_SESSION_ID=wis
MESSAGE_STORE_QUEUE_NAME=local-inthub-message-store

# Observability
WORKFLOW_ID=wds-to-wis
MICROSERVICE_ID=wis_soap_sender
HEALTH_BOARD=WDS
PEER_SERVICE=WIS
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
