# FHIR Sender — local development environment
# Points at the local Promptly mock (promptly-mock-receiver, the http_mock_receiver container).
# The real Promptly endpoint must be HTTPS (staging base: https://wpas-fhir.stg.labs.promptly.health).
# "$" is written as %24 so Compose / podman-compose do not treat "$process" as a variable.
# To run the sender on the host against a host-run mock, use http://localhost:8080/fhir/r4/%24process-message

FHIR_ENDPOINT_URL=http://promptly-mock-receiver:8080/fhir/r4/%24process-message
FHIR_ALLOW_INSECURE_HTTP=true
FHIR_AUTH_MODE=api_key
FHIR_API_KEY=local-dev-key
FHIR_POLL_INTERVAL_SECONDS=1

# Service Bus — local emulator
SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
INGRESS_QUEUE_NAME=local-inthub-fhir-sender
INGRESS_SESSION_ID=wpas-to-proms

# Observability
WORKFLOW_ID=wpas-to-proms
MICROSERVICE_ID=fhir-sender
HEALTH_BOARD=PROMS
PEER_SERVICE=PROMPTLY
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
