SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
INGRESS_TOPIC_NAME="local-inthub-lims-transformer-ingress"
INGRESS_SUBSCRIPTION_NAME="local-inthub-lims-transformer-ingress-trrr-sub"
# Must match the LIMS SOAP server's EGRESS_SESSION_ID (local/env/servers/lims-soap-hl7-server.env).
INGRESS_SESSION_ID="lims-to-mpi"

DB_SERVER="sqledge"
DB_PORT=1433
DB_NAME="Clinical_Results"
DB_STORED_PROCEDURE="dbo.TRRRIDUpdate"
DB_USERNAME="sa"
DB_ENCRYPT="No"
DB_TRUST_SERVER_CERTIFICATE="Yes"
DB_CONNECTION_TIMEOUT=30
DB_COMMAND_TIMEOUT=60
DEFAULT_IS_PRIORITY=0

WORKFLOW_ID="lims-to-trrr"
MICROSERVICE_ID="db_sender_trrr"
HEALTH_BOARD="SHARED"
PEER_SERVICE="TRRR"
HEALTH_CHECK_HOST="0.0.0.0"
HEALTH_CHECK_PORT=9000
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
MAX_BATCH_SIZE=10
