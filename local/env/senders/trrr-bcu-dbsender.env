SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
INGRESS_TOPIC_NAME="local-inthub-lims-trrr-mapped"
INGRESS_SUBSCRIPTION_NAME="local-inthub-lims-trrr-bcu-db-sender-sub"
# Must match the TRRR mappers' EGRESS_SESSION_ID (local/env/transformers/lims-trrr-*-mapper.env).
INGRESS_SESSION_ID="lims-trrr-mapped"
# Board writer for both NHS_ID_UPDATE and MERGE requests (request type identified from the JSON body).

DB_SERVER="mock-db-receiver"
DB_PORT=1433
DB_NAME="Clinical_Results"
DB_STORED_PROCEDURE="dbo.spProcessResult"
DB_USERNAME="sa"
DB_ENCRYPT="No"
DB_TRUST_SERVER_CERTIFICATE="Yes"
DB_CONNECTION_TIMEOUT=30
DB_COMMAND_TIMEOUT=60
DEFAULT_IS_PRIORITY=0

WORKFLOW_ID="lims-to-trrr"
MICROSERVICE_ID="db_sender_trrr_bcu"
HEALTH_BOARD="BCU"
PEER_SERVICE="TRRR"
HEALTH_CHECK_HOST="0.0.0.0"
HEALTH_CHECK_PORT=9000
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
MAX_BATCH_SIZE=10
