SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
INGRESS_TOPIC_NAME="local-inthub-cav-trrr-id-update"
INGRESS_SUBSCRIPTION_NAME="local-inthub-cav-trrr-id-update-db-writer-sub"
# Must match the CAV PMS TRRR merge mapper's EGRESS_SESSION_ID (local/env/transformers/cav-pms-trrr-merge-mapper.env).
INGRESS_SESSION_ID="cav-trrr-id-update"
# CAV TRRR ID update DB writer: executes the mapped TRRRIDUpdate (merge) JSON request.

DB_SERVER="mock-db-receiver"
DB_PORT=1433
DB_NAME="Clinical_Results"
DB_STORED_PROCEDURE="dbo.spProcessIdUpdate"
DB_USERNAME="sa"
DB_ENCRYPT="No"
DB_TRUST_SERVER_CERTIFICATE="Yes"
DB_CONNECTION_TIMEOUT=30
DB_COMMAND_TIMEOUT=60
DEFAULT_IS_PRIORITY=0

WORKFLOW_ID="cav-pms-to-trrr"
MICROSERVICE_ID="cav_trrr_id_update_db_writer"
HEALTH_BOARD="CAV"
PEER_SERVICE="TRRR"
HEALTH_CHECK_HOST="0.0.0.0"
HEALTH_CHECK_PORT=9000
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
MAX_BATCH_SIZE=10
