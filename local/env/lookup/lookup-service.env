ENVIRONMENT="LOCAL"
# Skips Entra token validation and Easy Auth. Outside ENVIRONMENT=LOCAL the service refuses to start with this,
# except DEV/TST with LOOKUP_AUTH_DISABLED_ACK set (see lookup_service/README.md).
LOOKUP_AUTH_DISABLED="true"
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT="8080"
# Local only: tables imported on first start, mounted from local/lookup-seed by docker-compose.yml.
LOOKUP_SEED_DIR="/seed"
# Cosmos DB emulator. The key is the emulator's publicly documented well-known key, not a secret.
COSMOS_ENDPOINT="https://cosmos-emulator:8081"
COSMOS_KEY="C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw=="
COSMOS_DATABASE="integration-hub"
COSMOS_DISABLE_SSL_VERIFY="true"
LOOKUP_ROWS_CONTAINER="lookup-rows"
LOOKUP_CONFIG_CONTAINER="lookup-config"
LOOKUP_DEFAULT_TTL_SECONDS="300"
LOOKUP_MAX_UPLOAD_MB="50"
