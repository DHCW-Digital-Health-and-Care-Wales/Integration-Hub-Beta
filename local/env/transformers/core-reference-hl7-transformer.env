SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
INGRESS_QUEUE_NAME="local-inthub-core-reference-transformer-ingress"
INGRESS_SESSION_ID="risp-to-mpi"
EGRESS_QUEUE_NAME="local-inthub-mpi-sender-ingress"
EGRESS_SESSION_ID="mpi"
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
WORKFLOW_ID="risp-to-mpi"
MICROSERVICE_ID="core_reference_hl7_transformer"
HEALTH_BOARD="SHARED"
PEER_SERVICE="MPI"

# WRDS SOAP endpoint (Welsh Reference Data Service) — no local WRDS emulator exists.
# This points at http_mock_receiver (run separately, see ../http_mock_receiver/README.md),
# which will log the request but will NOT return a valid GetResultSetResponse, so translated
# PID fields will come back empty ("") when testing locally. Point at the real WRDS SIT
# endpoint instead if you need to verify actual code translations.
WRDS_ENDPOINT_URL="https://example.test/wrdssoapservice"
WRDS_TIMEOUT_SECONDS=30
WRDS_CLIENT_CERT_PATH=
WRDS_LOOKUP_TABLE_NAME=FioranoCodeTranslation

# Optional: skip the real WRDS call entirely (e.g. when the real endpoint is unreachable, such as
# no VPN route from inside a container) and read a canned SOAP response from a local XML fixture
# instead. The fixture is gitignored (hl7_core_reference_transformer/hl7_core_reference_transformer/
# wrds_local_fixture.xml) — edit it locally with a captured/example GetResultSetResponse body, then
# uncomment the line below and rebuild the container.
# WRDS_LOCAL_FIXTURE_PATH="/app/hl7_core_reference_transformer/wrds_local_fixture.xml"

