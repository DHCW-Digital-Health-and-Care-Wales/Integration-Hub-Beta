SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
INGRESS_TOPIC_NAME="local-inthub-lims-hl7-input"
INGRESS_SUBSCRIPTION_NAME="local-inthub-lims-trrr-nhsid-mapper-sub"
# Must match the LIMS SOAP server's EGRESS_SESSION_ID (local/env/servers/lims-soap-hl7-server.env).
INGRESS_SESSION_ID="lims-soapserver"
EGRESS_TOPIC_NAME="local-inthub-lims-trrr-mapped"
# Every TRRR db sender listens on this session ID (INGRESS_SESSION_ID in local/env/senders/trrr-*.env).
EGRESS_SESSION_ID="lims-trrr-mapped"
# A31 / A40 NHS-ID update: LIMS identifier + NHS number -> dbo.spProcessIdUpdate (3 parameters).
TRRR_MAPPING_TYPE="NHS_ID_UPDATE"

WORKFLOW_ID="lims-to-trrr"
MICROSERVICE_ID="lims_trrr_nhsid_mapper"
HEALTH_BOARD="SHARED"
PEER_SERVICE="TRRR"
HEALTH_CHECK_HOST="0.0.0.0"
HEALTH_CHECK_PORT=9000
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
MAX_BATCH_SIZE=10
