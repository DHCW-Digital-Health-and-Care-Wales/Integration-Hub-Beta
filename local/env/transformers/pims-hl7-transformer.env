SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
INGRESS_TOPIC_NAME="local-inthub-pims-hl7-input"
INGRESS_SUBSCRIPTION_NAME="local-inthub-pims-transformer-sub"
INGRESS_SESSION_ID="pims-to-mpi"
EGRESS_TOPIC_NAME="local-inthub-mpi-sender-ingress"
EGRESS_SESSION_ID="mpi"
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
WORKFLOW_ID="pims-to-mpi"
MICROSERVICE_ID="pims_hl7_transformer"
HEALTH_BOARD="PIMS"
PEER_SERVICE="MPI"
# lookup_service (pims_to_mpi_codes table) used to enrich PID gender / marital status /
# ethnic group / NHS number status. Start it with `--profile lookup`.
#
# To point at a service running on the host instead (e.g. Podman on Windows, where
# host.docker.internal does not forward to the host), override REFERENCE_DATA_API_BASE_URL in an
# untracked pims-hl7-transformer.local.env file alongside this one, e.g.:
#   REFERENCE_DATA_API_BASE_URL="http://192.168.127.254:8090"
REFERENCE_DATA_API_BASE_URL="http://lookup-service:8080"
