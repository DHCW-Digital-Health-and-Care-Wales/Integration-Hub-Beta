SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
INGRESS_QUEUE_NAME="local-inthub-pims-transformer-ingress"
INGRESS_SESSION_ID="pims-to-mpi"
EGRESS_QUEUE_NAME="local-inthub-mpi-sender-ingress"
EGRESS_SESSION_ID="mpi"
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
WORKFLOW_ID="pims-to-mpi"
MICROSERVICE_ID="pims_hl7_transformer"
HEALTH_BOARD="PIMS"
PEER_SERVICE="MPI"
# Reference-data API (WRDS/WRRS lookups) used to enrich PID gender / marital status /
# ethnic group / NHS number status. The lookup service is supplied separately and run on
# the host (bound to 0.0.0.0:8085); point this at it from inside the container.
#
# The default below works for Docker Desktop (macOS/Windows/WSL) and most Linux setups.
# On some hosts (e.g. Podman on Windows, where host.docker.internal/host.containers.internal
# does not forward to the host) override REFERENCE_DATA_API_BASE_URL in an untracked
# pims-hl7-transformer.local.env file alongside this one, e.g.:
#   REFERENCE_DATA_API_BASE_URL="http://192.168.127.254:8085"
REFERENCE_DATA_API_BASE_URL="http://host.docker.internal:8085"
