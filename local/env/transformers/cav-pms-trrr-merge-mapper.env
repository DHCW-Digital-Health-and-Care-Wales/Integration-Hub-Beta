SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
# CAV PMS ADT topic; the subscription only receives MSH-3 = 140 (SourceSystem) and MSH-9.2 = A40 (MessageType).
INGRESS_TOPIC_NAME="local-inthub-pms-sender-ingress"
INGRESS_SUBSCRIPTION_NAME="local-inthub-pms-trrr-merge-mapper-sub"
# Must match the PMS HL7 server's EGRESS_SESSION_ID (local/env/servers/pms-hl7-server.env).
INGRESS_SESSION_ID="pms-to-mpi"
# Durable CAV TRRR ID Update topic consumed by cav-trrr-id-update-db-writer.
EGRESS_TOPIC_NAME="local-inthub-cav-trrr-id-update"
EGRESS_SESSION_ID="cav-trrr-id-update"
# A40 patient merge: MRG old identifier -> PID-3 new identifier -> dbo.spProcessIdUpdate (4 parameters).
TRRR_MAPPING_TYPE="MERGE"

WORKFLOW_ID="cav-pms-to-trrr"
MICROSERVICE_ID="cav_pms_trrr_merge_mapper"
HEALTH_BOARD="CAV"
PEER_SERVICE="TRRR"
HEALTH_CHECK_HOST="0.0.0.0"
HEALTH_CHECK_PORT=9000
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
MAX_BATCH_SIZE=10
