# Integration Hub - Local Development Commands (Docker Edition)
# ============================================
#
# A modern command runner for Integration Hub local development using Docker.
#
# Quick Start Guide:
# -----------------
# 1. List all available commands:     just --list --file docker.justfile
# 2. Install dependencies:            just --file docker.justfile install
# 3. Generate secrets:                just --file docker.justfile secrets
# 4. Build a profile:                 just --file docker.justfile build phw-to-mpi
# 5. Start services:                  just --file docker.justfile start phw-to-mpi
# 6. Send a test message:             just --file docker.justfile send test_message.hl7
# 7. View logs:                       just --file docker.justfile logs mpi-hl7-mock-receiver
# 8. Stop all services:               just --file docker.justfile stop
#
# Available Profiles:
# ------------------
# - phw-to-mpi     : Public Health Wales to MPI integration
# - lims-to-mpi    : LIMS SOAP ingress to MPI integration
# - pms-soap-to-mpi: PMS SOAP ingress to MPI integration
# - paris-to-mpi   : PARIS to MPI integration
# - chemo-to-mpi   : Chemo to MPI integration
# - pims-to-mpi    : PIMS to MPI integration
# - mosaiq-to-mpi  : Mosaiq to MPI integration
# - wds-to-mpi     : WDS to MPI integration
# - wpas-to-proms  : PROMS REST ingress to MPI integration
# - mpi-to-topic   : MPI to Outbound Integration
#
# Tips:
# -----
# - Most commands provide detailed feedback with next steps
# - Dependencies are handled automatically (e.g., secrets are generated when needed)
# - Use 'just run' as a shortcut to install, generate secrets, and start services
# - Pass multiple profiles by repeating commands or use "*" for all profiles
#
# For more information, see local/README.md

# ============================================
# Configuration Variables
# ============================================

# Use PowerShell as the recipe shell on Windows hosts.
set windows-shell := ["pwsh.exe", "-NoLogo", "-NoProfile", "-Command"]

# Compose filters services by *active* profile, and `--profile "*"` is NOT a
# wildcard (it's treated as a literal, nonexistent profile name). To operate on
# containers across every profile (e.g. `logs`, `stop`), every real profile must
# be passed explicitly.
all_profiles_flags := "--profile phw-to-mpi --profile lims-to-mpi --profile pms-soap-to-mpi --profile paris-to-mpi --profile chemo-to-mpi --profile pims-to-mpi --profile mosaiq-to-mpi --profile wds-to-mpi --profile wpas-to-proms --profile mpi-to-topic --profile replay"

# Default MLLP port for sending HL7 messages
default_port := "2575"

# Secrets file path
secrets_file := ".secrets"

# Python interpreter
python := "python3"

# ============================================
# Default Recipe (shows help)
# ============================================

# Show this help message with all available commands
@default:
    just --list --unsorted --file docker.justfile

# ============================================
# Profiles
# ============================================

# Lists the available profiles
@profiles:
    echo "Available profiles for use with other commands:"
    echo ""
    echo "  - phw-to-mpi     : Public Health Wales to MPI integration"
    echo "  - lims-to-mpi    : LIMS SOAP ingress to MPI integration"
    echo "  - pms-soap-to-mpi: PMS SOAP ingress to MPI integration"
    echo "  - paris-to-mpi   : PARIS to MPI integration"
    echo "  - chemo-to-mpi   : Chemo to MPI integration"
    echo "  - pims-to-mpi    : PIMS to MPI integration"
    echo "  - mosaiq-to-mpi  : Mosaiq to MPI integration"
    echo "  - wds-to-mpi     : WDS to MPI integration"
    echo "  - wpas-to-proms  : PROMS REST ingress to MPI integration"
    echo "  - mpi-to-topic   : MPI Outbound integration"
    echo "  - replay         : Message Replay Job"
    echo ""
    echo "💡 Run 'just --file docker.justfile start <profile>' to start services"

# ============================================
# Setup & Installation
# ============================================

# Install Python dependencies (hl7 library for MLLP operations)
@install:
    echo "📦 Installing Python dependencies..."
    echo ""
    {{python}} -m pip install hl7
    echo ""
    echo "✅ Installation complete!"
    echo "💡 Next steps:"
    echo "   - Run 'just --file docker.justfile secrets' to generate required secrets"
    echo "   - Run 'just --file docker.justfile start <profile>' to start services"

# Generate the .secrets file with random values (required for containers)
@secrets:
    echo "🔒 Generating secrets file..."
    echo ""
    {{python}} generate_secrets.py > {{secrets_file}}
    echo "✅ Secrets file created at: ./{{secrets_file}}"
    echo "💡 This file contains randomly generated secrets for local development"
    echo "💡 Next step: Run 'just --file docker.justfile start <profile>' to launch services"

# ============================================
# Docker Compose Container Management
# ============================================

# Build (or rebuild) Docker containers for a specific profile
@build profile:
    echo "⚒️  Building Docker containers for profile: {{profile}}"
    echo ""
    echo "📋 Profile selected: {{profile}}"
    echo "🔨 This may take a few minutes on first build..."
    echo ""
    docker compose --profile {{profile}} build
    echo ""
    echo "✅ Build complete for profile: {{profile}}"
    echo "💡 Next step: Run 'just --file docker.justfile start {{profile}}' to start the services"

# Start Docker containers for a specific profile (auto-generates secrets if needed)
@start profile: (_ensure-secrets)
    echo "▶️  Starting Docker Compose services..."
    echo ""
    echo "📋 Profile: {{profile}}"
    echo "🚀 Launching containers in detached mode..."
    echo ""
    docker compose --profile {{profile}} up -d
    echo ""
    echo "✅ Services started successfully!"
    echo "📍 Running containers for profile: {{profile}}"
    echo ""
    echo "💡 Next steps examples:"
    echo "   - Check status: docker ps"
    echo "   - View logs: just --file docker.justfile logs phw-hl7-server"
    echo "   - Send test message: just --file docker.justfile send ./sample_messages/phw-to-mpi.sample.hl7"
    echo "   - Stop services: just --file docker.justfile stop"

# Stop all Docker containers across all profiles
@stop:
    echo "⏹️  Stopping all Docker Compose services..."
    echo ""
    docker compose {{all_profiles_flags}} down
    echo ""
    echo "✅ All services stopped"
    echo "💡 To restart: just --file docker.justfile start <profile>"

# ============================================
# Testing & Debugging
# ============================================

# Send a HL7 message to a specific port (default: 2575)
@send file port=default_port:
    echo "🧪 Sending HL7 message..."
    echo ""
    echo "📄 File: {{file}}"
    echo "🔌 Port: {{port}}"
    echo "🎯 Target: 127.0.0.1:{{port}}"
    echo ""
    # HL7 separates segments with CR only, which terminals render as an overwrite of the
    # previous line. Translate CR to LF so the ACK is legible instead of appearing corrupt.
    mllp_send --loose --file {{file}} --port {{port}} 127.0.0.1 | {{python}} -c "import sys; sys.stdout.write(sys.stdin.read().replace('\r','\n'))"
    echo ""
    echo "✅ Message sent!"
    echo "💡 Check logs with: just --file docker.justfile logs <service-name>"
    echo "💡 Profile specific ports:"
    echo "   - 2575 (PHW)"
    echo "   - 2577 (PARIS)"
    echo "   - 2578 (Chemo)"
    echo "   - 2579 (PIMS)"
    echo "   - 2580 (MPI Outbound)"
    echo "   - 8084 (PROMS REST)"

# Send a SOAP-wrapped HL7 XML message to the hl7-soap-server (default: lims-to-mpi sample, port 8082)
@send-soap file="./sample_messages/lims-to-mpi.sample.xml" port="8082":
    echo "🧪 Sending SOAP HL7 message..."
    echo ""
    echo "📄 File: {{file}}"
    echo "🎯 Target: http://127.0.0.1:{{port}}/soap"
    echo ""
    {{python}} -c "import urllib.request, sys; body = open(sys.argv[1], 'rb').read(); req = urllib.request.Request(sys.argv[2], data=body, headers={'Content-Type': 'text/xml; charset=utf-8'}, method='POST'); resp = urllib.request.urlopen(req); print(f'Status: {resp.status}'); print(resp.read().decode())" "{{file}}" "http://127.0.0.1:{{port}}/soap"
    echo ""
    echo "✅ Message sent!"
    echo "💡 Check logs with: just --file docker.justfile logs hl7-soap-server"

# Send an HTTP/REST HL7 message to a REST server (default: proms sample, port 8084)
@send-rest file="./sample_messages/wpas-to-proms.sample.hl7" port="8084":
    echo "🧪 Sending REST HL7 message..."
    echo ""
    echo "📄 File: {{file}}"
    echo "🎯 Target: http://127.0.0.1:{{port}}/hl7MessageReceiver"
    echo ""
    {{python}} -c "import urllib.request, sys; body = open(sys.argv[1], 'rb').read(); req = urllib.request.Request(sys.argv[2], data=body, headers={'Content-Type': 'text/plain; charset=utf-8'}, method='POST'); resp = urllib.request.urlopen(req); print(f'Status: {resp.status}'); print(resp.read().decode())" "{{file}}" "http://127.0.0.1:{{port}}/hl7MessageReceiver"
    echo ""
    echo "✅ Message sent!"
    echo "💡 Check logs with: just --file docker.justfile logs <service-name>"

# Follow logs from Docker containers (optionally filter by service name, e.g. `just --file docker.justfile logs hl7-soap-server`)
@logs *services:
    echo "📖 Following container logs..."
    echo ""
    {{ if services == "" { "echo '📋 Showing logs for all services'" } else { "echo '📋 Filtering logs for: " + services + "'" } }}
    echo "💡 Press Ctrl+C to stop following logs"
    echo ""
    docker compose {{all_profiles_flags}} logs -f {{services}}

# ============================================
# Convenience Recipes
# ============================================

# Complete setup: install dependencies, generate secrets (if needed), and optionally start services
@run *profile: (_ensure-secrets)
    echo "🚀 Running complete setup..."
    echo ""
    just --file docker.justfile install
    echo ""
    {{ if profile != "" { "echo ''\njust --file docker.justfile start " + profile } else { "echo ''\necho \"✅ Setup complete! Ready to start services.\"\necho \"💡 Run 'just --file docker.justfile start <profile>' to launch a specific profile\"" } }}

# Rebuild containers and restart services for a profile (useful after code changes)
@restart profile:
    echo "🔄 Rebuilding and restarting services..."
    echo ""
    just --file docker.justfile build {{profile}}
    echo ""
    just --file docker.justfile stop
    echo ""
    just --file docker.justfile start {{profile}}
    echo ""
    echo "✅ Services rebuilt and restarted!"

# Clean up: stop all containers and remove the secrets file
@clean:
    echo "🧹 Cleaning up local environment..."
    echo ""
    just --file docker.justfile stop
    echo ""
    echo "🗑️  Removing secrets file..."
    rm -f {{secrets_file}}
    echo ""
    echo "✅ Cleanup complete!"
    echo "💡 Run 'just --file docker.justfile run' to set up the environment again"

# ============================================
# Internal Helper Recipes (prefixed with _)
# ============================================

# Internal: Ensure secrets file exists, generate if missing
@_ensure-secrets:
    {{ if path_exists(secrets_file) == "false" { "echo '🔒 Secrets file not found, generating...'\necho ''\njust --file docker.justfile secrets\necho ''" } else { "" } }}
